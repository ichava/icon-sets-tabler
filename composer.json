{
    "name": "ichava/icon-sets-tabler",
    "description": "6,238 Tabler SVG icons (5,184 outline, 1,054 filled) from tabler/tabler-icons, for Laravel 13 on the Ichava icon ecosystem.",
    "type": "library",
    "keywords": [
        "laravel",
        "blade",
        "icons",
        "svg",
        "tabler",
        "tabler-icons",
        "ichava"
    ],
    "homepage": "https://opensource.simtabi.com/products/ichava/icon-sets-tabler",
    "license": "MIT",
    "authors": [
        {
            "name": "Simtabi LLC",
            "email": "opensource@simtabi.com",
            "homepage": "https://simtabi.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4.1 || ^8.5",
        "illuminate/support": "^13.0",
        "ichava/core": "^0.1",
        "laranail/package-tools": "^0.1.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/ichava/core"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/package-tools.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/console.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/enumerator.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/db-tools.git"
        }
    ],
    "require-dev": {
        "composer/semver": "^3.4",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.6 || ^5.0",
        "phpstan/phpstan": "^2.1",
        "laravel/pint": "^1.18"
    },
    "autoload": {
        "psr-4": {
            "Simtabi\\Laranail\\Ichava\\IconSetsTabler\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Simtabi\\Laranail\\Ichava\\IconSetsTabler\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Simtabi\\Laranail\\Ichava\\IconSetsTabler\\Providers\\IconsServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "scripts": {
        "pint": "@php vendor/bin/laranail-pint --test",
        "pint-fix": "@php vendor/bin/laranail-pint --parallel",
        "lint": "@pint",
        "format": "@pint-fix",
        "test": "vendor/bin/pest --parallel",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=2G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "support": {
        "source": "https://github.com/ichava/icon-sets-tabler",
        "issues": "https://github.com/ichava/icon-sets-tabler/issues",
        "security": "https://github.com/ichava/icon-sets-tabler/security/policy",
        "docs": "https://opensource.simtabi.com/documentation/ichava/icon-sets-tabler/"
    }
}
